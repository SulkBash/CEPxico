# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Packaging / build
build/
dist/
*.egg-info/
*.spec

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Receipts and CEPs contain real financial data - keep them out of the repo
*.pdf
*.png
*.jpg
*.jpeg
*.webp
# ...except the README's pictures, made from invented data (scripts/record_demo.py)
!docs/*.png
!docs/*.gif

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# PyInstaller spec is source, not a build artifact
!packaging/cepxico.spec
